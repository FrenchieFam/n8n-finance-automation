        1100,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO run_log (run_at, workflow, status, detail) VALUES\n(strftime('%Y-%m-%dT%H:%M:%fZ','now'), 'csv-import', 'ok',\n'Processed CSV import via dedup external_id.');",
        "options": {}
      },
      "executeOnce": true,
      "credentials": {
        "sqliteCredentialsApi": {
          "name": "SQLite Database account"
        }
