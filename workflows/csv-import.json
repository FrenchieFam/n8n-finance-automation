      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "allowExpressions": false,
        "query": "INSERT OR IGNORE INTO expenses\n  (date, description, amount, currency, category, owner, source, external_id, notes, created_at)\nVALUES ($1, $2, $3, 'USD', NULL, 'me', 'csv', $4, $5, datetime('now'));",
        "options": {
          "queryReplacement": "={{ [$json.Date.trim().split('/')[2] + '-' + $json.Date.trim().split('/')[0] + '-' + $json.Date.trim().split('/')[1], ($json.Description || '').trim(), -1 * (parseFloat($json['Amount Debit'] || 0) + parseFloat($json['Amount Credit'] || 0)), 'eecu:' + $json['Transaction Number'].trim(), ($json.Memo || '').trim()] }}"
        }
      },
      "alwaysOutputData": true,
      "credentials": {
        "sqliteCredentialsApi": {
          "name": "SQLite Database account"
        }
      }
    },
