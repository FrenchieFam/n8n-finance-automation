      "typeVersion": 3.5,
      "position": [
        336,
        304
      ]
    },
    {
      "parameters": {
        "fileName": "={{ $json.path }}",
        "dataPropertyName": "={{ $binary.data ? 'data' : Object.keys($binary)[0] }}",
        "options": {}
      },
      "id": "8a395ff1-76ce-4fb8-9e16-771c5846c80d",
      "name": "Save Receipt Image",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        448,
        304
      ]
    },
    {
      "id": "a03e3aa2-6c99-4b32-bddf-51c715dcd360",
      "name": "Parse Extraction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        304
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "try {\n  const msg = $input.first().json.message?.content;\n  if (!msg || msg.trim() === '' || msg.trim() === '{}') {\n    throw new Error('Empty or missing content from Ollama');\n  }\n  const parsed = JSON.parse(msg);\n  if (!parsed.date || !parsed.merchant) {\n    throw new Error('Required fields missing from parsed JSON');\n  }\n  return {\n    json: {\n      ...parsed,\n      _error: false\n    }\n  };\n} catch (e) {\n  return {\n    json: {\n      _error: true\n    }\n  };\n}"
      }
    }
  ],
