      "id": "0597fbb5-2568-415f-884b-a931fdad2334",
      "name": "Image To Base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        672,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5vl:7b-q4_K_M\",\n  \"stream\": false,\n  \"format\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"date\": {\n        \"type\": \"string\"\n      },\n      \"merchant\": {\n        \"type\": \"string\"\n      },\n      \"total\": {\n        \"type\": \"number\"\n      },\n      \"currency\": {\n        \"type\": \"string\"\n      },\n      \"category\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"groceries\",\n          \"dining\",\n          \"transport\",\n          \"housing\",\n          \"utilities\",\n          \"subs\",\n          \"shopping\",\n          \"entertainment\",\n          \"health\",\n          \"other\"\n        ]\n      }\n    },\n    \"required\": [\n      \"date\",\n      \"merchant\",\n      \"total\",\n      \"currency\",\n      \"category\"\n    ]\n  },\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Extract receipt data. date in YYYY-MM-DD. total = final amount paid. If date is ambiguous use the most plausible recent date. Return only JSON.\",\n      \"images\": [\n        \"{{ $json.data }}\"\n      ]\n    }\n  ],\n  \"options\": {\n    \"num_ctx\": 8192\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 180000
        }
      },
      "id": "cd89b54a-7ffc-4b76-bd0c-ce8f2cf41791",
      "name": "Ollama Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        304
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "no-error",
              "leftValue": "={{ $json._error }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6d899f8e-aac2-44ab-bc1b-a7ee71f6f2f1",
      "name": "Filter",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        1328,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO expenses\n  (date, description, amount, currency, category, owner, source, receipt_path, notes, created_at)\nVALUES\n  (IFNULL($1, date('now')),\n   IFNULL($2, 'Unknown Merchant'),\n   IFNULL($3, 0),\n   IFNULL($4, 'USD'),\n   IFNULL($5, 'other'),\n   $6,\n   'receipt',\n   $7,\n   IFNULL($8, 'OCR via qwen2.5vl'),\n   datetime('now'));",
        "options": {
          "queryReplacement": "={{ [$json.date ?? null, $json.merchant ?? null, $json.total ?? null, $json.currency ?? null, $json.category ?? null, $('Form Trigger').first().json.owner, $('Save Receipt Image').item.json.path, 'OCR via qwen2.5vl'] }}"
        }
      },
      "id": "80569ba5-40b5-4127-983f-60f1d6f24b6d",
      "name": "Insert Receipt Expense",
      "type": "n8n-nodes-sqlite3.sqliteNode",
      "typeVersion": 2,
      "position": [
        1552,
        304
      ],
      "alwaysOutputData": true,
      "credentials": {
        "sqliteCredentialsApi": {
          "name": "SQLite Database account"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "392a2726-1dbf-46b2-b4cf-08cd2ccd45e2",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        448,
        304
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "receipt-path",
              "name": "path",
              "type": "string",
              "value": "=/data/receipts/{{$now.format('yyyy-MM')}}/{{ ($binary.data ?? Object.values($binary)[0]).fileName }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {
          "stripBinary": false
        }
      },
      "id": "a543fff6-4a43-4796-be99-9f6dfa83d6ed",
      "name": "Prepare Receipt Path",
